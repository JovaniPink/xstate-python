  {
    "id": "coarse-clock-cascade",
    "chart": {
      "id": "cascade",
      "context": {
        "n": 0
      },
      "initial": "first",
      "states": {
        "first": {
          "after": {
            "1000": "second"
          }
        },
        "second": {
          "after": {
            "500": "third"
          }
        },
        "third": {}
      }
    },
    "commands": [
      {
        "type": "start"
      },
      {
        "type": "advance",
        "ms": 1500
      }
    ],
    "known_difference": "Native SimulatedClock semantics differ: JS advances now before firing, scheduling the next delay from 1500; Python fires at each deadline and reaches the second deadline at 1500.",
    "expected": [
      {"time": 0, "value": "first", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": [], "events": []}, "errors": []},
      {"time": 1500, "value": "second", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": [], "events": []}, "errors": []}
    ],
    "expected_python": [
      {"time": 0, "value": "first", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": [], "events": []}, "errors": []},
      {"time": 1500, "value": "third", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": [], "events": []}, "errors": []}
    ]
  },
  {
    "id": "missing-named-delay",
    "chart": {
      "id": "delay",
      "context": {
        "n": 0
      },
      "initial": "waiting",
      "states": {
        "waiting": {
          "after": {
            "MISSING": "done"
          }
        },
        "done": {
          "type": "final"
        }
      }
    },
    "commands": [
      {
        "type": "start"
      }
    ],
    "known_difference": "An unregistered descriptive delay fails explicitly in Python. XState 5.33.4 queues the after event immediately when its delay resolves to undefined. This is a diagnostic boundary, not requested parity.",
    "expected": [
      {"time": 0, "value": "done", "context": {"n": 0}, "status": "done", "output": null, "actions": [], "children": {"active": [], "events": []}, "errors": []}
    ],
    "expected_python": [
      {"time": 0, "value": "waiting", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": [], "events": []}, "errors": [{"type": "UnregisteredImplementationError", "message": "Delay 'MISSING' is not configured. Pass it via Machine(config, delays={'MISSING': ...})."}]}
    ]
  }
