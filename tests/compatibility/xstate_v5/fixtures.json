  {
    "id": "guard-assign-raise-eventless",
    "chart": {
      "id": "sequence",
      "context": {
        "n": 0
      },
      "initial": "idle",
      "states": {
        "idle": {
          "on": {
            "GO": {
              "guard": "allowed",
              "target": "receiving",
              "actions": [
                "increment",
                "raiseInner"
              ]
            }
          }
        },
        "receiving": {
          "on": {
            "INNER": "settling"
          }
        },
        "settling": {
          "always": "done"
        },
        "done": {
          "type": "final"
        }
      }
    },
    "commands": [
      {
        "type": "start"
      },
      {
        "type": "send",
        "event": {
          "type": "GO",
          "allow": false
        }
      },
      {
        "type": "send",
        "event": {
          "type": "GO",
          "allow": true
        }
      }
    ],
    "expected": [
      {"time": 0, "value": "idle", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": [], "events": []}, "errors": []},
      {"time": 0, "value": "idle", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": [], "events": []}, "errors": []},
      {"time": 0, "value": "done", "context": {"n": 1}, "status": "done", "output": null, "actions": [], "children": {"active": [], "events": []}, "errors": []}
    ]
  },
  {
    "id": "causal-action-arguments",
    "chart": {
      "id": "causal",
      "context": {
        "n": 0
      },
      "initial": "idle",
      "states": {
        "idle": {
          "on": {
            "GO": {
              "guard": "allowed",
              "target": "receiving",
              "actions": [
                {
                  "type": "record",
                  "params": {
                    "label": "before"
                  }
                },
                "increment",
                {
                  "type": "record",
                  "params": {
                    "label": "after"
                  }
                },
                "raiseInner"
              ]
            }
          }
        },
        "receiving": {
          "on": {
            "INNER": {
              "target": "settling",
              "actions": {
                "type": "record",
                "params": {
                  "label": "raised"
                }
              }
            }
          }
        },
        "settling": {
          "always": {
            "target": "done",
            "actions": {
              "type": "record",
              "params": {
                "label": "eventless"
              }
            }
          }
        },
        "done": {
          "type": "final"
        }
      }
    },
    "commands": [
      {
        "type": "start"
      },
      {
        "type": "advance",
        "ms": 250
      },
      {
        "type": "send",
        "event": {
          "type": "GO",
          "allow": true,
          "source": "outside"
        }
      }
    ],
    "known_difference": "WP3: Python deferred actions observe final context and the outer event; XState actions observe context/event at their execution position.",
    "expected": [
      {"time": 0, "value": "idle", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": [], "events": []}, "errors": []},
      {"time": 250, "value": "idle", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": [], "events": []}, "errors": []},
      {"time": 250, "value": "done", "context": {"n": 1}, "status": "done", "output": null, "actions": [{"time": 250, "context": {"n": 0}, "event": {"type": "GO", "allow": true, "source": "outside"}, "params": {"label": "before"}}, {"time": 250, "context": {"n": 1}, "event": {"type": "GO", "allow": true, "source": "outside"}, "params": {"label": "after"}}, {"time": 250, "context": {"n": 1}, "event": {"type": "INNER"}, "params": {"label": "raised"}}, {"time": 250, "context": {"n": 1}, "event": {"type": "INNER"}, "params": {"label": "eventless"}}], "children": {"active": [], "events": []}, "errors": []}
    ],
    "expected_python": [
      {"time": 0, "value": "idle", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": [], "events": []}, "errors": []},
      {"time": 250, "value": "idle", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": [], "events": []}, "errors": []},
      {"time": 250, "value": "done", "context": {"n": 1}, "status": "done", "output": null, "actions": [{"time": 250, "context": {"n": 1}, "event": {"type": "GO", "allow": true, "source": "outside"}, "params": {"label": "before"}}, {"time": 250, "context": {"n": 1}, "event": {"type": "GO", "allow": true, "source": "outside"}, "params": {"label": "after"}}, {"time": 250, "context": {"n": 1}, "event": {"type": "GO", "allow": true, "source": "outside"}, "params": {"label": "raised"}}, {"time": 250, "context": {"n": 1}, "event": {"type": "GO", "allow": true, "source": "outside"}, "params": {"label": "eventless"}}], "children": {"active": [], "events": []}, "errors": []}
    ]
  },
  {
    "id": "callback-child-reentry",
    "chart": {
      "id": "child",
      "context": {
        "n": 0
      },
      "initial": "active",
      "states": {
        "active": {
          "invoke": {
            "id": "worker",
            "src": "worker",
            "input": {
              "label": "worker"
            }
          },
          "on": {
            "RESET": {
              "target": "active",
              "reenter": true
            },
            "LEAVE": "idle"
          }
        },
        "idle": {}
      }
    },
    "commands": [
      {
        "type": "start"
      },
      {
        "type": "advance",
        "ms": 25
      },
      {
        "type": "send",
        "event": {
          "type": "RESET"
        }
      },
      {
        "type": "send",
        "event": {
          "type": "LEAVE"
        }
      }
    ],
    "known_difference": "WP4: explicit state reentry does not restart Python invoked children; a later real exit does stop the existing child.",
    "expected": [
      {"time": 0, "value": "active", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": ["worker"], "events": [{"time": 0, "kind": "start", "generation": 1, "input": {"label": "worker"}}]}, "errors": []},
      {"time": 25, "value": "active", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": ["worker"], "events": []}, "errors": []},
      {"time": 25, "value": "active", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": ["worker"], "events": [{"time": 25, "kind": "stop", "generation": 1}, {"time": 25, "kind": "start", "generation": 2, "input": {"label": "worker"}}]}, "errors": []},
      {"time": 25, "value": "idle", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": [], "events": [{"time": 25, "kind": "stop", "generation": 2}]}, "errors": []}
    ],
    "expected_python": [
      {"time": 0, "value": "active", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": ["worker"], "events": [{"time": 0, "kind": "start", "generation": 1, "input": {"label": "worker"}}]}, "errors": []},
      {"time": 25, "value": "active", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": ["worker"], "events": []}, "errors": []},
      {"time": 25, "value": "active", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": ["worker"], "events": []}, "errors": []},
      {"time": 25, "value": "idle", "context": {"n": 0}, "status": "active", "output": null, "actions": [], "children": {"active": [], "events": [{"time": 25, "kind": "stop", "generation": 1}]}, "errors": []}
    ]
  },
